# Travian-Solo Environment Configuration
# Docker Development Environment

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=travian_global
DB_USERNAME=travian_user
DB_PASSWORD=travian_password123

# Application Settings
APP_URL=http://localhost
APP_DEBUG=true
DOMAIN=localhost

# Security
SECURE_HASH_SALT=travian_development_salt_12345
SESSION_LIFETIME=86400
COOKIE_SECURE=false

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=noreply@travian.local
SMTP_FROM_NAME=Travian

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# reCAPTCHA (Optional)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Game World Configuration
TESTWORLD_SPEED=100
DEMO_SPEED=5

# External Services
SENDINBLUE_API_KEY=

# Docker MySQL Configuration
MYSQL_ROOT_PASSWORD=root_password123
MYSQL_DATABASE=travian_global
MYSQL_USER=travian_user
MYSQL_PASSWORD=travian_password123
