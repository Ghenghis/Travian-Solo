{
    "name": "travian-solo/game-server",
    "description": "Travian Solo Game Server - Production Ready",
    "type": "project",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.10",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^1.11",
        "phpmd/phpmd": "^2.14",
        "phploc/phploc": "^7.0",
        "sebastian/phpcpd": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "sections/api/include/Core/",
            "Api\\": "sections/api/include/Api/",
            "Middleware\\": "sections/api/include/Middleware/",
            "Model\\": "sections/api/include/Model/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html tests/coverage/html",
        "test-security": "phpunit --testsuite Core --filter SecurityTest",
        "test-middleware": "phpunit --testsuite Middleware",
        "lint": "vendor/bin/phpcs --standard=PSR12 sections tests",
        "lint:fix": "vendor/bin/phpcbf --standard=PSR12 sections tests",
        "fixer": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "fixer:apply": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "stan": "vendor/bin/phpstan analyse sections tests --memory-limit=1G",
        "md": "vendor/bin/phpmd sections text phpmd.xml",
        "loc": "vendor/bin/phploc sections tests",
        "dup": "vendor/bin/phpcpd sections tests"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
